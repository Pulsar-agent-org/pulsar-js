        "type": "challenge",
        "header": "Pulsar network=\"stellar:testnet\", asset=\"XLM\", amount=\"0.002\", pay_to=\"GD4RJ43KGBZ3FNV4LCWZGYNPJQZPITK37QJYRCTF62LPY5S4LRETDAZW\", nonce=\"90AA9A441C48F8A68BE1686F3FF7DA1184BF7EAF9F721A0C0B675A0A33109225\", expires=\"1789431692\""
      },
      "expect": { "ok": false, "error": "malformed_request" }
    },
