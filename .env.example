# Copy to .env for the examples and the paying client. Testnet only.

# Horizon endpoint used to resolve and submit transactions.
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Asset the paid tool prices in. CODE:ISSUER for a credit asset, or XLM.
PULSAR_ASSET=XLM

# The provider account that receives payment. A G... public key.
# Generate a test account and fund it with friendbot:
#   https://friendbot.stellar.org/?addr=<G...>
PULSAR_PAY_TO=

# The paying client's secret key (S...). Never commit a funded secret.
# The paying-agent prints the address to fund on first run.
PULSAR_CLIENT_SECRET=
